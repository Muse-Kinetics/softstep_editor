   <property name="styleSheet">
    <string notr="true">/* ---------- QCheckBox ------------*/
QCheckBox
{
    color: rgba(255,255,255,0);
    font: 10pt &quot;Futura&quot;;
}

QCheckBox::indicator
{
    width: 20px;
    height: 20px;
}

QCheckBox::indicator:unchecked
{
    image: url(:/resources/modline_enable1_toggle_off.png);
}

QCheckBox::indicator:unchecked:hover
{
    image: url(:/resources/modline_enable1_toggle_off.png);
}

QCheckBox::indicator:unchecked:pressed
{
    image: url(:/resources/modline_enable1_toggle_on.png);
}

QCheckBox::indicator:checked
{
    image: url(:/resources/modline_enable1_toggle_on.png);
}

QCheckBox::indicator:checked:pressed
{
    image: url(:/resources/modline_enable1_toggle_off.png);
}

QCheckBox::indicator:unchecked:focus
{
    image: url(:/resources/modline_enable1_toggle_off.png);
}

QCheckBox::indicator:unchecked:pressed:focus
{
    image: url(:/resources/modline_enable1_toggle_on.png);
}

QCheckBox::indicator:checked:focus
{
    image: url(:/resources/modline_enable1_toggle_on.png);
}

QCheckBox::indicator:checked:pressed:focus
{
    image: url(:/resources/modline_enable1_toggle_off.png);
}
</string>
