  <property name="styleSheet">
   <string notr="true">QWidget
{
/*	background: rgb(0,0,0); */
	background:		rgb(80, 80, 80);	
	border: 3px rgb(25, 25, 25);
}

/* ------- QStackedWidget ---------*/
QStackedWidget
{
	background: none;
	border-left: 2px solid rgb(0,174,239);
	border-right: 2px solid rgb(0,174,239);
}

/* ---------- QLabels ------------*/
QLabel
{
	background:		none;
	color: 				white;
	font: 				8pt &quot;Tahoma&quot;;
	border:				none;
}

QLabel:hover
{
	border:				none;
}  

/* ---------- QSpinBox ------------*/
QSpinBox
{
	font: 8pt &quot;Tahoma&quot;;
	border: 1px solid rgb(0,174,239);
	background-color: rgb(18, 18, 18);
	color: white;
	padding: 1px 1px 1px 3px;
}

QSpinBox::focus
{
	border: none;
	outline: none;
}

QDoubleSpinBox
{
	font: 8pt &quot;Tahoma&quot;;
	border: 1px solid rgb(0,174,239);
	background-color: rgb(18, 18, 18);
	color: white;
	padding: 1px 1px 1px 3px;
}

QDoubleSpinBox::focus
{
	border: none;
	outline: none;
}

/* ---------- QLineEdit ------------*/
QLineEdit
{
	font: 8pt &quot;Tahoma&quot;;
	background: rgb(18, 18, 18);
	border: 1px solid rgb(0,174,239);
	border-radius: 0px;
	color: white;
	padding-left: 2px;
	padding-bottom: 2px;
}

QLineEdit:focus
{
	font: 8pt &quot;Tahoma&quot;;
	background: rgb(0,174,239);
	border: 1px solid white;
	border-radius: 0px;
	color: white;
	padding-left: 2px;
	padding-bottom: 2px;
}

/* ---------- QCheckBox ------------*/
QCheckBox
{
	font: 8pt &quot;Tahoma&quot;;
	background: none;
	color: white;
	padding:0, 3, 0, 0;
	border: none;
	border-radius: 0px;
}

QCheckBox:focus
{
	background: none;
}

/*----------- QComboBox ------------*/
QComboBox
{
	font: 8pt &quot;Tahoma&quot;;
	border: 1px solid rgb(0,174,239);
	background: rgb(18, 18, 18);
	color: white;
	padding: 1px 3px 1px 4px;
 }

QComboBox QListView
{
	background-color: rgb(40, 40, 40);
	border: transparent;
	font: 9px &quot;Tahoma&quot;;
	padding-left: 3px;
	padding-right: 3px;
	min-width: 35px;
}

QComboBox::item:alternate
{
	background: rgb(90, 90, 90);
}

QComboBox::item:selected
{
	border: 1px solid transparent;
	background: rgb(0,174,239);
}

QComboBox::indicator
{
	background-color: transparent;
	selection-background-color: transparent;
	color: transparent;
	selection-color: white;
}

QComboBox::drop-down
{
	width: 1px;
	height: 1px;
	subcontrol-origin: margin;
	subcontrol-position: right center;
	border-left-width: 0px;
	border-right-width: 0px;
	border-top-width: 0px;
	border-bottom-width: 0px;
}

QComboBox::down-arrow
{
	border: none;
	background: none;
	image: url(:/resources/modline_combobox_menu_arrows.png);
	padding-right: 10px;
}
</string>
