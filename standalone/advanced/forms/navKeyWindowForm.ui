   </property>
   <property name="toolTip">
    <string>Sets the Nav Pad mode.&lt;p&gt;&lt;b&gt;Modline&lt;/b&gt;: Use the Nav Pad with the modlines below like a regular SoftStep key.&lt;p&gt;&lt;b&gt;Program Change&lt;/b&gt;: For use with the Nav Yx10 &amp; Key” source — this allows the Nav pad to count &quot;decades&quot; from 0 to 12. This option will disable the use of modlines on the Nav Pad.</string>
   </property>
   <property name="styleSheet">
    <string notr="true">/*-------QRadioButton-------*/

QRadioButton
{
	color: rgba(255,255,255,250);
	font: 10pt &quot;Futura-Normal&quot;;
	border: none;
}

QRadioButton::indicator  {
    width: 16px;
    height: 16px;
}
 
QRadioButton::indicator::unchecked  {
    image: url(:/resources/radiobutton_unchecked.png);
}
 
QRadioButton::indicator:unchecked:hover  {
    image: url(:/resources/radiobutton_unchecked.png);
}
 
QRadioButton::indicator:unchecked:pressed  {
    image: url(:/resources/radiobutton_pressed.png);
}
 
QRadioButton::indicator::checked  {
    image: url(:/resources/radiobutton_checked.png);
}
 
QRadioButton::indicator:checked:hover  {
    image: url(:/resources/radiobutton_checked.png);
}
 
QRadioButton::indicator:checked:pressed  {
    image: url(:/resources/radiobutton_pressed.png);
}</string>
   </property>
