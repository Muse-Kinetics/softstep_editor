    <string notr="true">/*-------QRadioButton-------*/

QRadioButton
{
	color: rgba(255,255,255,250);
	font: 10pt &quot;Futura&quot;;
	border: none;
}

QRadioButton::indicator  {
    width: 16px;
    height: 16px;
}
 
QRadioButton::indicator::unchecked  {
    image: url(:/resources/radiobutton_unchecked.png);
}
 
