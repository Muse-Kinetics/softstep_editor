  <property name="styleSheet">
   <string notr="true">QWidget
{
	background:		rgb(60, 60, 60);

}

QFrame
{
		border: 4px solid rgb(0,174,239);
}

/* ---------- QLabels ------------*/
QLabel
{
	background:		none;
	color: 				white;
	font: 				7pt &quot;Tahoma&quot;;
	border:				none;
}

QLabel:hover
{
	border:				none;
}

/* ---------- QSpinBox ------------*/
QSpinBox
{
	font: 8pt &quot;Futura-Normal&quot;;
	border: 1px solid rgb(0,174,239);
	background-color: (18, 18, 18);
	color: white;
	padding:0, 3, 0, 0;
}

QSpinBox:focus
{
	border: 1px solid rgb(255,255,255);
	outline: none;
}

/* ---------- QCheckBox ------------*/
QCheckBox
{
	font: 8pt &quot;Futura-Normal&quot;;
	background: none;
	color: white;
	padding:0, 3, 0, 0;
	border: none;
}

QCheckBox:focus
{
	background: none;
}

/* ---------- QLineEdit ------------*/
QLineEdit
{
	font: 7pt &quot;Tahoma&quot;;
	background: rgb(18, 18, 18);
	border: 1px solid rgb(0,174,239);
	border-radius: 0px;
	color: white;
	padding-left: 2px;
	padding-bottom: 2px;
}

QLineEdit:focus
{
	border: 1px solid rgb(255,255,255);
	outline: none;
}

/*----------- QComboBox ------------*/
QComboBox
{
	font: 8px &quot;Tahoma&quot;;
	border: 1px solid rgb(0,174,239);
	background: rgb(18, 18, 18);
	color: white;
	padding: 1px 3px 1px 4px;
 }

QComboBox QListView
{
	background-color: rgb(40, 40, 40);
	border: transparent;
	font: 11px &quot;Tahoma&quot;;
	color: white;
	padding-left: 3px;
	padding-right: 3px;
	min-width: 35px;
}

QComboBox::item:alternate
{
	background: rgb(90, 90, 90);
}

QComboBox::item:selected
{
	border: 1px solid transparent;
	background: rgb(0,174,239);
}

QComboBox::indicator
{
	background-color: transparent;
	selection-background-color: transparent;
	color: transparent;
	selection-color: white;
}

QComboBox::drop-down
{
	width: 1px;
	height: 1px;
	subcontrol-origin: margin;
	subcontrol-position: right center;
	border-left-width: 0px;
	border-right-width: 0px;
	border-top-width: 0px;
	border-bottom-width: 0px;
}

QComboBox::down-arrow
{
	border: none;
	background: none;
	image: url(:/resources/modline_combobox_menu_arrows.svg);
	padding-right: 12px;
    width: 11px;
    height: 11px;
}

/*-------QToolTip-------*/
QToolTip
{
	font: 10px &quot;Corbel&quot;;
	color: rgb(255, 255, 255);
	background: rgba(40, 40, 40, 140);
	border: 1px solid rgb(120, 120, 120);
	padding: 2px;
}</string>
  </property>
