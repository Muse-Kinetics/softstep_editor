  <property name="styleSheet">
   <string notr="true">QWidget#keyForm
{
	background:		rgba(35,31,32,255);
	border: 6px solid rgba(0,174,239,255);
}  

QWidget:hover
{
	/*border:				3px solid rgb(0, 126, 126);*/
}        

/* ---------- QLabels ------------*/
QLabel
{
	background:		rgba(0,0,0,0);
	color: 				white;
	font: 				14px &quot;Futura&quot;;
	border:				none;
}

QLabel:hover
{
	border:				none;
}  

/* ---------- QSpinBox ------------*/
QSpinBox
{
	font: 14px &quot;Futura&quot;;
	border: 2px solid rgb(0,174,239);
	background-color: rgba(0, 0, 0, 255);
	color: white;
	padding:0, 3, 0, 0;
}

QSpinBox::focus
{
	border: none;
	outline: none;
}

/* ---------- QLineEdit ------------*/
QLineEdit
{
	font: 14px&quot;Futura&quot;;
	background: rgba(60,60,60,255);
	border: 2px solid rgba(0,174,239,255);
	border-radius: 0px;
	color: white;
	padding-left: 2px;
	padding-bottom: 2px;
}

QLineEdit:focus
{
	font: 14px &quot;Futura&quot;;
	background: rgba(0,174,239,0);
	border: 2px solid white;
	border-radius: 0px;
	color: white;
	padding-left: 2px;
	padding-bottom: 2px;
}

/* ---------- QCheckBox ------------*/
QCheckBox
{
	color: rgba(255,255,255,250);
	background: rgba(0,0,0,0);
	font: 12px &quot;Futura&quot;;
	border:	none;

}

QCheckBox::indicator {
     width: 14px;
     height: 14px;
	padding:0, 0, 0, 0;
 }

  QCheckBox::indicator::unchecked {
     image: url(:/resources/radio_off.svg);
 }

 QCheckBox::indicator:unchecked:hover {
     image: url(:/resources/radio_off.svg);
 }

 QCheckBox::indicator:unchecked:pressed {
     image: url(:/resources/radio_on.svg);
 }

 QCheckBox::indicator::checked {
     image: url(:/resources/radio_on.svg);
 }

 QCheckBox::indicator:checked:pressed {
     image: url(:/resources/radio_off.svg);
 }

 QCheckBox::indicator::unchecked:focus {
     image: url(:/resources/radio_focus_off.svg);
 }

 QCheckBox::indicator:unchecked:pressed:focus {
     image: url(:/resources/radio_focus_on.svg);
 }

 QCheckBox::indicator::checked:focus {
     image: url(:/resources/radio_focus_on.svg);
 }

 QCheckBox::indicator:checked:pressed:focus {
     image: url(:/resources/radio_focus_off.svg);
 }

/* ------- QStackedWidget ---------*/
QStackedWidget
{
border-top: 1px solid white;
background: black;
}



