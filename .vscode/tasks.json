{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build SoftStep Basic Editor Debug",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\ezpz\\softstepezpz.pro",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\standalone\\build-softstepezpz-Desktop_Qt_6_3_2_MSVC2019_64bit-Debug",
        "dedicatedTasks": {
          "label": "$(rocket) Build Basic Editor Debug",
          "detail": "Build the SoftStep Basic Editor debug binary",
          "groups": [
            [
              "SoftStep",
              "Basic"
            ],
            "Debug"
          ],
          "order": 1
        }
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Build SoftStep Basic Editor Release",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\ezpz\\softstepezpz.pro",
        "build",
        "${workspaceFolder}\\standalone\\build-softstepezpz-Desktop_Qt_6_3_2_MSVC2019_64bit-Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "dedicatedTasks": {
          "label": "$(package) Build Basic Editor Release",
          "detail": "Build the SoftStep Basic Editor release binary",
          "groups": [
            [
              "SoftStep",
              "Basic"
            ],
            "Release"
          ],
          "order": 1
        }
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "Clean SoftStep Basic Editor Debug",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\ezpz\\softstepezpz.pro",
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\standalone\\build-softstepezpz-Desktop_Qt_6_3_2_MSVC2019_64bit-Debug"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "Tail SoftStep Basic Editor Log",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\tail-log.ps1",
        "${env:APPDATA}\\Keith McMillen Instruments\\SoftStep Basic Editor\\logs"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Tail SoftStep Advanced Editor Log",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\tail-log.ps1",
        "${env:APPDATA}\\Keith McMillen Instruments\\SoftStep Advanced Editor\\logs"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Build SoftStep Advanced Editor Debug",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\advanced\\SoftStepAdvanced.pro",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\standalone\\build-SoftStepAdvanced-Desktop_Qt_6_3_2_MSVC2019_64bit-Debug",
        "dedicatedTasks": {
          "label": "$(rocket) Build Advanced Editor Debug",
          "detail": "Build the SoftStep Advanced Editor debug binary",
          "groups": [
            [
              "SoftStep",
              "Advanced"
            ],
            "Debug"
          ],
          "order": 1
        }
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Build SoftStep Advanced Editor Release",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\advanced\\SoftStepAdvanced.pro",
        "build",
        "${workspaceFolder}\\standalone\\build-SoftStepAdvanced-Desktop_Qt_6_3_2_MSVC2019_64bit-Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "dedicatedTasks": {
          "label": "$(package) Build Advanced Editor Release",
          "detail": "Build the SoftStep Advanced Editor release binary",
          "groups": [
            [
              "SoftStep",
              "Advanced"
            ],
            "Release"
          ],
          "order": 1
        }
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "Clean SoftStep Advanced Editor Debug",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\advanced\\SoftStepAdvanced.pro",
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\standalone\\build-SoftStepAdvanced-Desktop_Qt_6_3_2_MSVC2019_64bit-Debug"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "Build SoftStep Editors Debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build SoftStep Basic Editor Debug",
        "Build SoftStep Advanced Editor Debug"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Make SoftStep Windows Installer",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\make-installer.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Make SoftStep Windows Installer (No Signing)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\make-installer.ps1",
        "-DisableSigning"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Deploy SoftStep Windows Installer",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build SoftStep Basic Editor Release",
        "Build SoftStep Advanced Editor Release",
        "Make SoftStep Windows Installer"
      ],
      "problemMatcher": []
    },
    {
      "label": "Deploy SoftStep Windows Installer (No Signing)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build SoftStep Basic Editor Release",
        "Build SoftStep Advanced Editor Release",
        "Make SoftStep Windows Installer (No Signing)"
      ],
      "problemMatcher": []
    }
  ]
}
