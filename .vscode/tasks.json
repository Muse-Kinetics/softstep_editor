{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SoftStep Basic Win Build (Debug)",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\ezpz\\softstepezpz.pro",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\standalone\\build-softstepezpz-Desktop_Qt_6_3_2_MSVC2019_64bit-Debug",
        "dedicatedTasks": {
          "label": "$(rocket) Build Basic Editor Debug",
          "detail": "Build the SoftStep Basic Editor debug binary",
          "groups": [
            [
              "SoftStep",
              "Basic"
            ],
            "Debug"
          ],
          "order": 1
        }
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "SoftStep Basic Win Build",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\ezpz\\softstepezpz.pro",
        "build",
        "${workspaceFolder}\\standalone\\build-softstepezpz-Desktop_Qt_6_3_2_MSVC2019_64bit-Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "dedicatedTasks": {
          "label": "$(package) Build Basic Editor Release",
          "detail": "Build the SoftStep Basic Editor release binary",
          "groups": [
            [
              "SoftStep",
              "Basic"
            ],
            "Release"
          ],
          "order": 1
        }
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "SoftStep Basic Win Clean",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\ezpz\\softstepezpz.pro",
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\standalone\\build-softstepezpz-Desktop_Qt_6_3_2_MSVC2019_64bit-Debug"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "SoftStep Basic Win Tail Log",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\tail-log.ps1",
        "${env:APPDATA}\\Keith McMillen Instruments\\SoftStep Basic Editor\\logs"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "SoftStep Advanced Win Tail Log",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\tail-log.ps1",
        "${env:APPDATA}\\Keith McMillen Instruments\\SoftStep Advanced Editor\\logs"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "SoftStep Advanced Win Build (Debug)",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\advanced\\SoftStepAdvanced.pro",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\standalone\\build-SoftStepAdvanced-Desktop_Qt_6_3_2_MSVC2019_64bit-Debug",
        "dedicatedTasks": {
          "label": "$(rocket) Build Advanced Editor Debug",
          "detail": "Build the SoftStep Advanced Editor debug binary",
          "groups": [
            [
              "SoftStep",
              "Advanced"
            ],
            "Debug"
          ],
          "order": 1
        }
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "SoftStep Advanced Win Build",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\advanced\\SoftStepAdvanced.pro",
        "build",
        "${workspaceFolder}\\standalone\\build-SoftStepAdvanced-Desktop_Qt_6_3_2_MSVC2019_64bit-Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "dedicatedTasks": {
          "label": "$(package) Build Advanced Editor Release",
          "detail": "Build the SoftStep Advanced Editor release binary",
          "groups": [
            [
              "SoftStep",
              "Advanced"
            ],
            "Release"
          ],
          "order": 1
        }
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "SoftStep Advanced Win Clean",
      "type": "process",
      "command": "${workspaceFolder}\\.vscode\\run-msvc-qmake-task.cmd",
      "args": [
        "..\\advanced\\SoftStepAdvanced.pro",
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\standalone\\build-SoftStepAdvanced-Desktop_Qt_6_3_2_MSVC2019_64bit-Debug"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "SoftStep Win Build (All, Debug)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "SoftStep Basic Win Build (Debug)",
        "SoftStep Advanced Win Build (Debug)"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "SoftStep Win Installer",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\make-installer.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "SoftStep Win Installer (No Signing)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\make-installer.ps1",
        "-DisableSigning"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "SoftStep Win Deploy",
      "dependsOrder": "sequence",
      "dependsOn": [
        "SoftStep Basic Win Build",
        "SoftStep Advanced Win Build",
        "SoftStep Win Installer"
      ],
      "problemMatcher": []
    },
    {
      "label": "SoftStep Win Deploy (No Signing)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "SoftStep Basic Win Build",
        "SoftStep Advanced Win Build",
        "SoftStep Win Installer (No Signing)"
      ],
      "problemMatcher": []
    },
    {
      "label": "SoftStep Basic Mac Build",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/run-qmake-task.sh",
      "args": [
        "${workspaceFolder}/standalone/ezpz/softstepezpz.pro",
        "build",
        "${workspaceFolder}/build-macos-basic-release",
        "CONFIG+=release"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "SoftStep Basic Mac Build (Debug)",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/run-qmake-task.sh",
      "args": [
        "${workspaceFolder}/standalone/ezpz/softstepezpz.pro",
        "build",
        "${workspaceFolder}/build-macos-basic-debug",
        "CONFIG+=debug"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "SoftStep Basic Mac Clean",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/run-qmake-task.sh",
      "args": [
        "${workspaceFolder}/standalone/ezpz/softstepezpz.pro",
        "clean",
        "${workspaceFolder}/build-macos-basic-release"
      ],
      "problemMatcher": []
    },
    {
      "label": "SoftStep Basic Mac Launch (Console)",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/launch-on-console.sh",
      "args": [
        "${workspaceFolder}/build-macos-basic-release/SoftStep Basic Editor.app/Contents/MacOS/SoftStep Basic Editor"
      ],
      "dependsOn": [
        "SoftStep Basic Mac Build"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "SoftStep Advanced Mac Build",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/run-qmake-task.sh",
      "args": [
        "${workspaceFolder}/standalone/advanced/SoftStepAdvanced.pro",
        "build",
        "${workspaceFolder}/build-macos-advanced-release",
        "CONFIG+=release"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "SoftStep Advanced Mac Build (Debug)",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/run-qmake-task.sh",
      "args": [
        "${workspaceFolder}/standalone/advanced/SoftStepAdvanced.pro",
        "build",
        "${workspaceFolder}/build-macos-advanced-debug",
        "CONFIG+=debug"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "SoftStep Advanced Mac Clean",
      "type": "process",
      "command": "${workspaceFolder}/.vscode/run-qmake-task.sh",
      "args": [
        "${workspaceFolder}/standalone/advanced/SoftStepAdvanced.pro",
        "clean",
        "${workspaceFolder}/build-macos-advanced-release"
      ],
      "problemMatcher": []
    },
    {
      "label": "SoftStep Advanced Mac Launch (Console)",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/launch-on-console.sh",
      "args": [
        "${workspaceFolder}/build-macos-advanced-release/SoftStep Advanced Editor.app/Contents/MacOS/SoftStep Advanced Editor"
      ],
      "dependsOn": [
        "SoftStep Advanced Mac Build"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "SoftStep Mac Build (All)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "SoftStep Basic Mac Build",
        "SoftStep Advanced Mac Build"
      ],
      "problemMatcher": []
    },
    {
      "label": "SoftStep Mac Make DMG",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/make-dmg-mac.sh",
      "args": [
        "SoftStep",
        "${workspaceFolder}/build-macos-basic-release/SoftStep Basic Editor.app",
        "${workspaceFolder}/build-macos-advanced-release/SoftStep Advanced Editor.app"
      ],
      "options": {
        "env": {
          "KMI_VERSION_PRO": "${workspaceFolder}/standalone/advanced/SoftStepAdvanced.pro"
        }
      },
      "dependsOn": [
        "SoftStep Mac Build (All)"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "SoftStep Mac Deploy",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/release-github-mac.sh",
      "args": [
        "Muse-Kinetics/softstep_editor",
        "SoftStep",
        "${workspaceFolder}/build-macos-basic-release/SoftStep Basic Editor.app"
      ],
      "options": {
        "env": {
          "KMI_VERSION_PRO": "${workspaceFolder}/standalone/advanced/SoftStepAdvanced.pro"
        }
      },
      "dependsOn": [
        "SoftStep Mac Make DMG"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
