{
  "name": "workspace-task-toolbar",
  "displayName": "Workspace Task Toolbar",
  "description": "Adds an editor toolbar dropdown for build, clean, test, and task execution in any workspace with a .vscode/tasks.json.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "workspaceTaskToolbar.runDefaultBuild",
        "title": "Build Default Task",
        "category": "Workspace Tasks"
      },
      {
        "command": "workspaceTaskToolbar.runBuildQuickPick",
        "title": "Choose Build Task",
        "category": "Workspace Tasks"
      },
      {
        "command": "workspaceTaskToolbar.runTestQuickPick",
        "title": "Choose Test Task",
        "category": "Workspace Tasks"
      },
      {
        "command": "workspaceTaskToolbar.runCleanQuickPick",
        "title": "Choose Clean Task",
        "category": "Workspace Tasks"
      },
      {
        "command": "workspaceTaskToolbar.runTaskQuickPick",
        "title": "Choose Any Task",
        "category": "Workspace Tasks"
      },
      {
        "command": "workspaceTaskToolbar.refresh",
        "title": "Refresh Task Toolbar Context",
        "category": "Workspace Tasks"
      }
    ],
    "submenus": [
      {
        "id": "workspaceTaskToolbar.menu",
        "label": "Tasks"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "submenu": "workspaceTaskToolbar.menu",
          "group": "navigation@100",
          "when": "workspaceTaskToolbar.hasTasksJson"
        }
      ],
      "workspaceTaskToolbar.menu": [
        {
          "command": "workspaceTaskToolbar.runDefaultBuild",
          "group": "1_build"
        },
        {
          "command": "workspaceTaskToolbar.runBuildQuickPick",
          "group": "1_build"
        },
        {
          "command": "workspaceTaskToolbar.runTestQuickPick",
          "group": "2_test"
        },
        {
          "command": "workspaceTaskToolbar.runCleanQuickPick",
          "group": "3_clean"
        },
        {
          "command": "workspaceTaskToolbar.runTaskQuickPick",
          "group": "4_run"
        },
        {
          "command": "workspaceTaskToolbar.refresh",
          "group": "5_misc"
        }
      ]
    }
  }
}